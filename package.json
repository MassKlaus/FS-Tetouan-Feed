{
  "name": "fs-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight static feed for the Faculté des Sciences de Tétouan announcements",
  "scripts": {
    "scrape": "tsx src/scrape/index.ts",
    "build": "tsx src/build/index.ts",
    "all": "npm run scrape && npm run build",
    "serve": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/checks/sanitize.test.ts",
    "check": "tsx src/checks/refs.ts && tsx src/checks/safe.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "domhandler": "^5.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
